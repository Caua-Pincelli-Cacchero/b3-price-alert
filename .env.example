# Copie para .env e preencha com valores locais.
# O .env está no .gitignore e nunca deve ser commitado.
#
# Não use aspas nos valores.
#
# POSTGRES_DB e POSTGRES_USER só são aplicados pelo entrypoint do Postgres
# quando o volume de dados está vazio. Se mudar depois, recrie com:
#   docker compose down -v

POSTGRES_DB=b3-price-alert
POSTGRES_USER=b3
POSTGRES_PASSWORD=troque-esta-senha
